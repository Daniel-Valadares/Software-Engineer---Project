<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ecocycle.controller.DisposalController">
    <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>

    <!-- Formulario de checklist de descarte -->
    <VBox spacing="12" styleClass="card">
        <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
        <Label text="Checklist de Descarte Responsavel (RF03)" styleClass="section-title"/>

        <GridPane hgap="16" vgap="12">
            <Label text="Ativo para Descarte:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <ComboBox fx:id="assetCombo" prefWidth="300" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Data do Descarte:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <DatePicker fx:id="disposedAtPicker" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Destino:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <ComboBox fx:id="destinationCombo" prefWidth="300" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        </GridPane>

        <!-- Checklist -->
        <VBox spacing="8" styleClass="checklist-box">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Label text="Itens de Verificacao Obrigatoria" styleClass="section-title"/>
            <CheckBox fx:id="diskSanitizedCheck" text="Disco rigido sanitizado (dados apagados com seguranca)"/>
            <CheckBox fx:id="batteryRemovedCheck" text="Bateria removida e encaminhada para ponto de coleta especifico"/>
        </VBox>

        <HBox spacing="10">
            <Button fx:id="registerButton" text="Registrar Descarte" onAction="#onRegister" styleClass="primary-button"/>
            <Button text="Limpar" onAction="#onClearForm"/>
        </HBox>

        <Label fx:id="feedbackLabel" text="" wrapText="true"/>
    </VBox>

    <!-- Historico de descartes -->
    <VBox spacing="8" styleClass="card" VBox.vgrow="ALWAYS">
        <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
        <Label text="Historico de Descartes" styleClass="section-title"/>

        <TableView fx:id="disposalsTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colDspId"      text="ID Descarte"   prefWidth="130"/>
                <TableColumn fx:id="colDspAsset"   text="Ativo"         prefWidth="100"/>
                <TableColumn fx:id="colDspDate"    text="Data"          prefWidth="100"/>
                <TableColumn fx:id="colDspDisk"    text="Disco OK"      prefWidth="90"/>
                <TableColumn fx:id="colDspBattery" text="Bateria OK"    prefWidth="90"/>
                <TableColumn fx:id="colDspDest"    text="Destino"       prefWidth="220"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
