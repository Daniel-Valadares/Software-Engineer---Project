<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="16" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ecocycle.controller.MonitoringController">
    <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>

    <!-- Cartoes de resumo -->
    <HBox spacing="12">
        <!-- Total -->
        <VBox styleClass="stat-card" alignment="CENTER" prefWidth="160" prefHeight="80">
            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
            <Label text="Total de Ativos" styleClass="stat-label"/>
            <Label fx:id="lblTotal" text="0" styleClass="stat-value"/>
        </VBox>
        <!-- Ativos -->
        <VBox styleClass="stat-card-active" alignment="CENTER" prefWidth="160" prefHeight="80">
            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
            <Label text="Em Uso" styleClass="stat-label"/>
            <Label fx:id="lblActive" text="0" styleClass="stat-value"/>
        </VBox>
        <!-- Expirando -->
        <VBox styleClass="stat-card-expiring" alignment="CENTER" prefWidth="160" prefHeight="80">
            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
            <Label text="Expirando (12 meses)" styleClass="stat-label"/>
            <Label fx:id="lblExpiring" text="0" styleClass="stat-value"/>
        </VBox>
        <!-- Vencido -->
        <VBox styleClass="stat-card-overdue" alignment="CENTER" prefWidth="160" prefHeight="80">
            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
            <Label text="Prazo Vencido" styleClass="stat-label"/>
            <Label fx:id="lblOverdue" text="0" styleClass="stat-value"/>
        </VBox>
        <!-- Descartados -->
        <VBox styleClass="stat-card-disposed" alignment="CENTER" prefWidth="160" prefHeight="80">
            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
            <Label text="Descartados" styleClass="stat-label"/>
            <Label fx:id="lblDisposed" text="0" styleClass="stat-value"/>
        </VBox>
    </HBox>

    <!-- Legenda de cores -->
    <HBox spacing="16" alignment="CENTER_LEFT">
        <Label text="Legenda: "/>
        <Label text="  Vencido  " styleClass="badge-overdue"/>
        <Label text="  Expirando  " styleClass="badge-expiring"/>
        <Label text="  Ativo  " styleClass="badge-active"/>
        <Label text="  Descartado  " styleClass="badge-disposed"/>
    </HBox>

    <!-- Tabela de ciclo de vida -->
    <VBox spacing="8" styleClass="card" VBox.vgrow="ALWAYS">
        <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Ciclo de Vida dos Ativos (RF02)" styleClass="section-title" HBox.hgrow="ALWAYS"/>
            <Button text="Atualizar" onAction="#onRefresh" styleClass="primary-button"/>
        </HBox>

        <TableView fx:id="monTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="monColId"         text="ID"              prefWidth="90"/>
                <TableColumn fx:id="monColCategory"   text="Categoria"       prefWidth="120"/>
                <TableColumn fx:id="monColModel"      text="Modelo"          prefWidth="170"/>
                <TableColumn fx:id="monColExpiration" text="Fim Previsto"    prefWidth="110"/>
                <TableColumn fx:id="monColDaysLeft"   text="Dias Restantes"  prefWidth="160"/>
                <TableColumn fx:id="monColDeprec"     text="Depreciacao"     prefWidth="100"/>
                <TableColumn fx:id="monColStatus"     text="Status"          prefWidth="90"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
